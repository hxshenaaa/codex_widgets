<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10">

  <Identity
    Name="CodexUsageWidget"
    Publisher="CN=CodexUsageWidgetDev"
    Version="1.1.10.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Codex Usage Widget</DisplayName>
    <PublisherDisplayName>CodexUsageWidgetDev</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-US" />
  </Resources>

  <Applications>
    <Application Id="App"
      Executable="CodexUsageWidgetProvider.exe"
      EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Codex Usage Widget"
        Description="Show Codex subscription usage on the Windows Widgets board"
        BackgroundColor="#2397C9"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        AppListEntry="none" />
      <Extensions>

        <!-- Registers the provider exe as a COM out-of-proc server so the
             widgets host can CoCreateInstance the IWidgetProvider below. -->
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:ExeServer Executable="CodexUsageWidgetProvider.exe" DisplayName="Codex Usage Widget Provider">
              <com:Class Id="d1db3a28-42d3-41d2-b968-eb646f3069d2" DisplayName="Codex Usage Widget Provider" />
            </com:ExeServer>
          </com:ComServer>
        </com:Extension>

        <!-- Registers this app as a Windows widget provider. -->
        <uap3:Extension Category="windows.appExtension">
          <uap3:AppExtension Name="com.microsoft.windows.widgets" DisplayName="Codex Usage Widget" Id="CodexUsageWidget" PublicFolder="Public">
            <uap3:Properties>
              <WidgetProvider>
                <ProviderIcons>
                  <Icon Path="Assets\StoreLogo.png" />
                </ProviderIcons>
                <Activation>
                  <CreateInstance ClassId="d1db3a28-42d3-41d2-b968-eb646f3069d2" />
                </Activation>
                <Definitions>
                  <Definition
                    Id="Codex_Usage_Widget"
                    DisplayName="Codex Usage"
                    Description="Codex subscription usage and reset time"
                    AllowMultiple="false"
                    WebRequestFilter="https://codexwidget.invalid/*">
                    <Capabilities>
                      <Capability>
                        <Size Name="small" />
                      </Capability>
                      <Capability>
                        <Size Name="medium" />
                      </Capability>
                      <Capability>
                        <Size Name="large" />
                      </Capability>
                    </Capabilities>
                    <ThemeResources>
                      <Icons>
                        <Icon Path="ProviderAssets\Codex_Icon.png" />
                      </Icons>
                      <Screenshots>
                        <Screenshot Path="ProviderAssets\Codex_Screenshot.png" DisplayAltText="Codex usage widget preview" />
                      </Screenshots>
                    </ThemeResources>
                  </Definition>
                </Definitions>
              </WidgetProvider>
            </uap3:Properties>
          </uap3:AppExtension>
        </uap3:Extension>

      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

</Package>
