<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CodexUsageWidgetProvider</RootNamespace>
    <AssemblyName>codex_probe</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.12" />
  </ItemGroup>

  <!-- Shares the Codex and account sources without referencing the Windows App SDK,
       so the WinAppSDK auto-initializer never runs in this probe exe. -->
  <ItemGroup>
    <Compile Include="..\CodexAppServerClient.cs" Link="CodexAppServerClient.cs" />
    <Compile Include="..\CodexAccounts.cs" Link="CodexAccounts.cs" />
    <Compile Include="..\CodexAccountConnection.cs" Link="CodexAccountConnection.cs" />
    <Compile Include="..\CodexProjectState.cs" Link="CodexProjectState.cs" />
    <Compile Include="..\CodexUsageService.cs" Link="CodexUsageService.cs" />
    <Compile Include="..\WebWidgetPage.cs" Link="WebWidgetPage.cs" />
    <Content Include="..\Assets\Weekly.png" Link="Assets\Weekly.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
